{
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|sw\\.js|firebase-messaging-sw\\.js|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
