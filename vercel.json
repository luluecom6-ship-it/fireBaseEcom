{
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|sw\\.js|firebase-messaging-sw\\.js|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/archive-logs",
      "schedule": "0 0 * * *"
    }
  ]
}
